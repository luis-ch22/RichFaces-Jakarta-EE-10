<?xml version='1.0' encoding='UTF-8'?>

<faces-config version="4.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xi="http://www.w3.org/2001/XInclude"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-facesconfig_4_0.xsd">

    <factory>
        <lifecycle-factory>org.richfaces.demo.arrangeablemodel.PersistenceLifecycleFactory</lifecycle-factory>
    </factory>
    <!--
        The former JSF managed beans opBean1/opBean2 (two request-scoped
        instances of OutputPanelBean under different names) are now provided by
        the CDI producers in OutputPanelBeanProducer.
    -->

    <application>
        <system-event-listener>
            <system-event-listener-class>org.richfaces.demo.push.TopicsContextMessageProducerInitializer</system-event-listener-class>
            <system-event-class>jakarta.faces.event.PostConstructApplicationEvent</system-event-class>
        </system-event-listener>
        <locale-config>
            <default-locale>en_US</default-locale>
            <supported-locale>en_US</supported-locale>
            <supported-locale>en</supported-locale>
        </locale-config>
        <message-bundle>ShowcaseErrorMessages</message-bundle>
    </application>


</faces-config>
